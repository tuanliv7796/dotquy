# Tên miền chính thức nơi bạn triển khai Website (cũng là nguồn phát gói cập nhật OTA cho ứng dụng .apk)
# Ví dụ: PUBLIC_SITE_URL=https://camnangdotquy.vn
# Lưu ý: Không có dấu gạch chéo '/' ở cuối. Khi để trống trong môi trường thử nghiệm, .apk chạy 100% từ gói Offline sẵn có.
PUBLIC_SITE_URL=

# Đường dẫn tương đối hoặc tuyệt đối tới manifest cập nhật OTA (mặc định tự ghép từ PUBLIC_SITE_URL + /ota/manifest.json)
PUBLIC_OTA_MANIFEST_URL=

# Thông tin Hội đồng Y khoa hiển thị công khai trên các bài viết
PUBLIC_MEDICAL_REVIEWER="Hội đồng Chuyên môn Đột quỵ (Đối chiếu chuẩn Bộ Y tế QĐ 3312/QĐ-BYT & AHA/ASA 2026)"
PUBLIC_LAST_MEDICAL_AUDIT="27/11/2026"
