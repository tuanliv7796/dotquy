# ============================================================================
# MẪU CẤU HÌNH CADDY CHO TÊN MIỀN RIÊNG (TỰ ĐỘNG HTTPS + PHÁT GÓI OTA CHO .APK)
# ============================================================================

ten-mien-cua-ban.vn {
    root * /var/www/dotquy115
    encode zstd gzip

    @otaManifest path /ota/manifest.json /sw.js
    header @otaManifest {
        Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Access-Control-Allow-Origin "*"
    }

    @otaBundle path /ota/bundle.zip
    header @otaBundle {
        Cache-Control "no-cache, must-revalidate"
        Access-Control-Allow-Origin "*"
    }

    @immutable path /_assets/* /fonts/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    file_server
}
