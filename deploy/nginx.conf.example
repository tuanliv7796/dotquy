# ============================================================================
# MẪU CẤU HÌNH NGINX CHO TÊN MIỀN RIÊNG (WEBSITE + MÁY CHỦ CẬP NHẬT OTA CHO .APK)
# Thư mục triển khai: chép toàn bộ nội dung trong dist/ lên /var/www/dotquy115
# ============================================================================

server {
    listen 443 ssl http2;
    server_name ten-mien-cua-ban.vn www.ten-mien-cua-ban.vn;

    # Thay bằng đường dẫn chứng chỉ SSL Let's Encrypt / Cloudflare của bạn
    ssl_certificate     /etc/letsencrypt/live/ten-mien-cua-ban.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ten-mien-cua-ban.vn/privkey.pem;

    root /var/www/dotquy115;
    index index.html;
    charset utf-8;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # QUAN TRỌNG SỐ 1: Không lưu cache cho ota/manifest.json và sw.js
    # Giúp ứng dụng Android (.apk) nhận biết ngay lập tức khi bạn đẩy bản mới lên Web!
    location = /ota/manifest.json {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        try_files $uri =404;
    }

    location = /ota/bundle.zip {
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header Access-Control-Allow-Origin "*" always;
        try_files $uri =404;
    }

    location = /sw.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    }

    # Cache dài hạn cho phông chữ .woff2 và tài nguyên đã gắn mã băm trong _assets/
    location ^~ /_assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ^~ /fonts/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }
}
